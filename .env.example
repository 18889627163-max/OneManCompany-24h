# OpenRouter API (used as OpenAI-compatible endpoint)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default model (used if not overridden per-agent in founding_employees.yaml)
DEFAULT_LLM_MODEL=openai/gpt-4o-mini

# Server
HOST=0.0.0.0
PORT=8000
# Optional process-level data-root override for isolated verification/recovery.
# Set this in the shell before process start; do not use it for live migration.
OMC_DATA_ROOT=
# SQLite-backed long-term memory (single-host standard v2)
OMC_MEMORY_ENABLED=false
OMC_AUTOMATION_ENABLED=true
# Set false for health/backup/restore verification processes so they cannot
# scan or auto-resume authoritative TaskTree work. Production default is true.
OMC_RESTORE_PERSISTED_TASKS=true
OMC_MEMORY_DATABASE_PATH=.onemancompany/data/runtime.sqlite3
OMC_MEMORY_EMBEDDING_BASE_URL=
OMC_MEMORY_EMBEDDING_API_KEY=
OMC_MEMORY_EMBEDDING_MODEL=
OMC_MEMORY_EMBEDDING_DIMENSIONS=
OMC_MEMORY_INDEX_VERSION=v1
OMC_ADMIN_TOKEN=
OMC_RUNTIME_BACKUP_DIR=backups/db
